# Only the design code, the CAD, the OpenRocket files and the docs are tracked.
/*
!/.gitignore
!/README.md
!/attitude_check.py
!/cea_analysis.py
!/chamber_hardware.py
!/design.py
!/feed_system.py
!/flight_plan.py
!/flight_plot.py
!/gimbal.py
!/heat_transfer.py
!/injector.py
!/injector_hardware.py
!/massIteration.py
!/openrocket_sim.py
!/plumbing_layout.py
!/rejected_cooling_checks.py
!/run_all.py
!/structure.py
!/two_phase.py
!/vehicle_layout.py
!/design_values.json
!/parts_list.csv
!/docs/
!/sim/
!/CAD/
/CAD/*
!/CAD/*.SLDPRT
!/CAD/*.SLDASM
!/CAD/avionics/
!/CAD/curves/
!/CAD/hardware/
!/CAD/legs/
!/CAD/mounts/
!/CAD/plumbing/
!/CAD/throttle/
!/CAD/torch/

# SolidWorks lock files and Python caches
~$*
__pycache__/
